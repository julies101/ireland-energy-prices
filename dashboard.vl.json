{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Ireland's energy price shock",
    "subtitle": "Drag across the timeline at the bottom to choose a period.",
    "anchor": "start", "fontSize": 18, "subtitleFontSize": 12
  },
  "data": {"url": "https://raw.githubusercontent.com/julies101/ireland-energy-prices/refs/heads/main/energy_prices.json"},
  "config": {"view": {"stroke": null}, "axis": {"labelFontSize": 11, "titleFontSize": 12}},
  "resolve": {"legend": {"color": "independent"}, "scale": {"color": "independent"}},
  "vconcat": [
    {
      "title": {"text": "1. Household electricity price", 
      "subtitle": "Index: 100 = average 2025 price. 50 = half the 2025 price, 125 = 25% more.",
      "anchor": "start", "fontSize": 14},
      "width": 700, "height": 220,
      "transform": [{"filter": "datum.series === 'Electricity'"}],
      "mark": {"type": "line", "color": "#d1495b", "strokeWidth": 2.5, "clip": true},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": null,
              "scale": {"domain": {"param": "brush"}},
              "axis": {"format": "%Y", "tickCount": "year"}},
        "y": {"field": "index", "type": "quantitative", "title": "Price index (2025 = 100)"},
        "tooltip": [
          {"field": "date", "type": "temporal", "format": "%b %Y", "title": "Month"},
          {"field": "index", "type": "quantitative", "format": ".1f", "title": "Index"},
          {"field": "yoy_pct", "type": "quantitative", "format": "+.1f", "title": "% change on a year earlier"}
        ]
      }
    },
    {
      "title": {"text": "Timeline: drag to select a period, double-click to reset", "anchor": "start", "fontSize": 12, "fontWeight": "normal", "color": "#555"},
      "width": 700, "height": 70,
      "transform": [{"filter": "datum.series === 'Electricity'"}],
      "mark": {"type": "area", "color": "#d1495b", "opacity": 0.4},
      "params": [{
        "name": "brush",
        "select": {"type": "interval", "encodings": ["x"]},
        "value": {"x": [{"year": 2019, "month": 1, "date": 1}, {"year": 2024, "month": 12, "date": 1}]}
      }],
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": null,
              "axis": {"format": "%Y", "tickCount": {"interval": "year", "step": 5},
                       "grid": false, "labelFontSize": 11}},
        "y": {"field": "index", "type": "quantitative", "title": null,
              "axis": {"tickCount": 2, "grid": false}}
      }
    }
  ]
}